# Task 10's G1 safe deny/allow test suite runner -- runs AS the pod's
# entrypoint (not invoked later via kubectl exec, which itself gets
# denied once the policy is enforce-mode; see cmd/g1-runner's package
# comment). Busybox base for /bin/true and /bin/false as designated safe
# exec targets.
FROM golang:1.21 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY cmd/g1-runner/ cmd/g1-runner/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o g1-runner ./cmd/g1-runner

FROM busybox:1.36
WORKDIR /
COPY --from=builder /workspace/g1-runner .
ENTRYPOINT ["/g1-runner"]
