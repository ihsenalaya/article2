# Task 10's single-shot exec/file/connect probe with precise errno
# capture, for G1's safe deny/allow tests. Busybox base (not distroless)
# so /bin/true exists as a designated safe exec target, matching the
# perf-workload image's pattern.
FROM golang:1.21 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY cmd/lsm-probe/ cmd/lsm-probe/

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o lsm-probe ./cmd/lsm-probe

FROM busybox:1.36
WORKDIR /
COPY --from=builder /workspace/lsm-probe .
ENTRYPOINT ["sleep", "infinity"]
