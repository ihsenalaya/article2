# Task 10: regenerates internal/bpfobjs/* (the compiled eBPF object +
# bpf2go Go bindings) against a target kernel's actual BTF
# (bpf/headers/vmlinux.h, dumped live from the target node via
# `bpftool btf dump file /sys/kernel/btf/vmlinux format c`, e.g. via
# `kubectl debug node`). Not used for the final agent image --
# ebpf-agent/Dockerfile's plain `go build` embeds whatever
# internal/bpfobjs/agent_x86_bpfel.{go,o} this stage produces, once
# copied back into the repo (see artifacts/experiments/bpf-lsm/exclusions.md
# for exactly how, including why the busybox-based output stage below is
# needed instead of `scratch` -- a scratch image has no shell for
# `kubectl exec`/`kubectl cp` to extract the files with).
#
# IMPORTANT: use golang:1.25-bookworm specifically (Debian 12, clang/llvm
# 14.x), not the default trixie base (clang 19) -- see exclusions.md's
# "clang version sensitivity" entry for the real bug this pins against.
FROM golang:1.25-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends clang llvm libbpf-dev && rm -rf /var/lib/apt/lists/* && clang --version

WORKDIR /
COPY operator/ operator/
WORKDIR /workspace
COPY ebpf-agent/go.mod go.mod
COPY ebpf-agent/go.sum go.sum
RUN go mod download
COPY ebpf-agent/bpf/ bpf/
COPY ebpf-agent/internal/bpfobjs/gen.go internal/bpfobjs/gen.go
WORKDIR /workspace/internal/bpfobjs
RUN go generate .
RUN ls -la

FROM busybox:1.36 AS output
COPY --from=0 /workspace/internal/bpfobjs/agent_x86_bpfel.go /
COPY --from=0 /workspace/internal/bpfobjs/agent_x86_bpfel.o /
ENTRYPOINT ["sleep", "infinity"]
